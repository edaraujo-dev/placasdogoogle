Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# Rotas curtas: /r/ED000001
RewriteRule ^r/([A-Za-z0-9_-]+)/?$ redirect.php?code=$1 [QSA,L]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|README\.md)$">
    Require all denied
</FilesMatch>
